# 复制成 .env 后按需修改。生产环境必填项已标 [必填]

# ---------- 环境 ----------
# 0/生产，1/开发。生产会关闭演示支付、收紧默认 CORS
RVCAMP_DEV=0

# [必填] 密钥哈希的 pepper。生成：python -c "import secrets;print(secrets.token_hex(32))"
# 改这个值会导致所有已发放的密钥失效（密钥不可找回，只能换发）
RVCAMP_PEPPER=

# 允许跨域的域名，逗号分隔。留空 = 纯同源（最安全）
RVCAMP_CORS=https://your-domain.com

# ---------- 后台 ----------
# 后台入口路径。别用 /admin，换成只有你自己知道的随机串
RVCAMP_ADMIN_PATH=/rv-backstage-7f3a
# 后台 IP 白名单，支持 CIDR。留空 = 不限制
RVCAMP_ADMIN_IP_WHITELIST=203.0.113.0/24

# 演示支付开关（自助开通会员）。生产必须为 0
RVCAMP_ALLOW_MOCK_PAY=0

# ---------- 底图（自建代理，零 Key）----------
# 瓦片代理前缀。/tiles = 走后端自建代理（磁盘缓存 + 防盗链，推荐）。
# 置空才会退回"浏览器直连源站"——那样源站会看到每个用户各自的高频请求，
# 是最容易被限流的形态，一般不该这么配。
RVCAMP_TILE_PROXY=/tiles

# 换上游：把上游指到自己生成的离线瓦片服务（见 deploy/selfhost-tiles/），
# 前端一行都不用改。默认 OpenFreeMap：免费、无 Key、允许商用。
# RVCAMP_TILE_UPSTREAM_OFM=http://127.0.0.1:7800
# 彻底关掉某个上游（例如不想让救急栅格回源 OSM）：
# RVCAMP_TILE_UPSTREAM_OSM_OFF=1

# 瓦片缓存：同时回源并发数、多少天没人看就淘汰、磁盘占用上限(MB)
RVCAMP_TILE_INFLIGHT=8
RVCAMP_TILE_CACHE_DAYS=180
RVCAMP_TILE_CACHE_MB=4096

# ---------- 业务 ----------
# 领取密钥是否需要图形验证码。默认开启——这是全站唯一"什么都不提供就能
# 拿走东西"的入口，不限的话一个脚本循环就能刷出几万个账号
RVCAMP_CAPTCHA=1
# 验证码有效期（秒）
RVCAMP_CAPTCHA_TTL=300
# 免费用户每天可查看的营地详情条数
RVCAMP_FREE_QUOTA=3
# 单张图片上限（MB）、单营地最多图片数
RVCAMP_MAX_IMAGE_MB=5
RVCAMP_MAX_IMAGES=8
# 原图最大边长 / 缩略图边长 / JPEG 质量
RVCAMP_IMAGE_MAX_EDGE=1600
RVCAMP_THUMB_EDGE=480
RVCAMP_JPEG_QUALITY=82

# ---------- 通知通道（不配也能跑，只是只发站内信）----------
# none=不发送 / console=打到日志 / http=POST 到自建网关
RVCAMP_SMS_PROVIDER=none
RVCAMP_SMS_ENDPOINT=
RVCAMP_SMTP_HOST=
RVCAMP_SMTP_PORT=465
RVCAMP_SMTP_USER=
RVCAMP_SMTP_PASS=

# ---------- 运维 ----------
RVCAMP_LOG_LEVEL=INFO
# 数据保留天数
RVCAMP_TOKEN_TTL_DAYS=30
RVCAMP_KEEP_AUDIT_DAYS=365
RVCAMP_KEEP_NOTIFY_DAYS=90
# 孤儿上传文件回收前的保留天数
RVCAMP_ORPHAN_AGE_DAYS=3
# 运维任务周期（秒）
RVCAMP_MAINTENANCE_INTERVAL=21600
